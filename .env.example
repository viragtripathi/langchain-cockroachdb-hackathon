# Copy this file to .env and fill it in.

# The database. This matches docker-compose.yml. For CockroachDB Cloud, paste
# your cluster's connection string (it works with postgresql:// too).
COCKROACHDB_URL=cockroachdb://root@localhost:26257/defaultdb?sslmode=disable

# Any LangChain chat model and embedding model, as "provider:model".
MODEL=openai:gpt-5.5
EMBEDDINGS=openai:text-embedding-3-small
OPENAI_API_KEY=

# Set to 1 to run without an API key. A scripted model calls the tools and a
# keyword-based embedding stands in for a real one. Good for checking your
# setup, not for smart answers.
OFFLINE=0
